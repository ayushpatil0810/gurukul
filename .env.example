# ==============================================================================
# HACKATHON STARTER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` and provide your actual values.
# NEVER commit sensitive production credentials or secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain your connection string from the Neon Console: https://console.neon.tech
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
# Example pooled connection for serverless:
# DATABASE_URL="postgresql://neondb_owner:npg_sample123@ep-cool-flower-a5xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. Authentication Configuration (Better Auth)
# ------------------------------------------------------------------------------
# BETTER_AUTH_SECRET: Encryption secret for session tokens (minimum 32 characters).
# Generate a new random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-character-or-longer-random-secret"

# BETTER_AUTH_URL: Base URL of your application
# For local development: http://localhost:3000
# For production (Vercel): https://your-domain.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Optional Public Configuration (Client-side)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
