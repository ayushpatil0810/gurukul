# Copy to `.env`. Docker Compose uses the same database credentials.

NODE_ENV=development

# node-postgres URL. Do not use a SQLAlchemy `postgresql+psycopg://` URL.
DATABASE_URL=postgresql://portal:portal@localhost:5433/portal
REDIS_URL=redis://localhost:6379/0

# Minimum 32 characters. Local demo default only.
BETTER_AUTH_SECRET=01234567890123456789012345678901
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEMETRY_URL=ws://localhost:3001

# Lesson studio only. Leave blank to keep the rest of the portal usable.
# The key is sent to the model and is never stored on a lesson.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini and https://api.openai.com/v1.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
